{
  "name": "map-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "validate-map": "node scripts/validate-map.mjs",
    "check-war-entry": "tsc -p tsconfig.scripts.json && node scripts/run-war-entry-check.cjs",
    "balance-check": "tsc -p tsconfig.scripts.json && node scripts/run-balance-check.cjs",
    "smoke": "tsc -p tsconfig.scripts.json && node scripts/run-smoke-test.cjs"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
